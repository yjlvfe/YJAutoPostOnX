{"nodes": [{"id": "readme_yjautopostonx_readme", "label": "YJAutoPostOnX README", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_yjautopostonx", "label": "YJAutoPostOnX", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_x_com", "label": "X.com", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_electron_30", "label": "Electron 30", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_playwright", "label": "Playwright", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_node_js_18", "label": "Node.js 18+", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_ai_studio", "label": "AI Studio", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_shared_queue", "label": "Shared Queue", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_publishing_engine", "label": "Publishing Engine", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_stage_independence", "label": "Independent Pipeline Stages", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Generation, queueing, and publishing are deliberately separated so publishing transmits queued posts verbatim without referral or quality-gate mutation."}, {"id": "readme_semantic_deduplication", "label": "Semantic Deduplication", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An Arabic-normalized, IDF-weighted semantic index rejects literal duplicates, paraphrases, and repeated ideas against all generated, queued, previewed, and previously published content."}, {"id": "readme_quality_gate", "label": "Strict Content Quality Gate", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Automatically rejects malformed, incomplete, incorrectly sized, or language-contaminated AI output before it reaches the shared queue."}, {"id": "readme_referral_link_injection", "label": "Generation-Time Referral Link Injection", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Referral links are inserted while content is generated so the publishing engine can remain referral-agnostic and post text unchanged."}, {"id": "readme_parallel_generation_sessions", "label": "Unbounded Parallel Generation Sessions", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The selected session count runs concurrently and can change during generation, with staggered launch preserving UI responsiveness at high concurrency."}, {"id": "readme_consumptive_queue", "label": "Consumptive Shared Queue", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Successful posts are immediately and permanently removed, while unpublished items remain in place for the next account or run, enforcing one-time publication."}, {"id": "readme_numbered_profiles", "label": "Ordered Numbered Profiles", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Profiles receive mandatory sequence numbers and publishing proceeds only forward from the selected profile, preventing backward wraparound."}, {"id": "readme_rate_limit_failover", "label": "Rate-Limit Failover", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A post that encounters an X daily limit is handed to the next account while the original account advances and enters a persisted cooldown."}, {"id": "readme_circuit_breaker", "label": "Publishing Circuit Breaker", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An account is stopped defensively after three consecutive unexplained failures."}, {"id": "readme_immediate_stop", "label": "Immediate Stop", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The stop action interrupts waits and retries within 200 milliseconds rather than waiting for an operation cycle to finish."}, {"id": "readme_anti_detection_automation", "label": "Anti-Detection Automation", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Random delays, natural pointer movement, human-like scrolling, and retries make automated posting behavior less mechanically uniform."}, {"id": "readme_virtual_lists", "label": "Virtual Lists", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Virtualized rendering keeps queue and preview interactions smooth with thousands of posts."}, {"id": "readme_live_run_reporting", "label": "Live Run Reporting", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Percentage, fractional progress, and per-session CSV logs expose ongoing publishing state."}, {"id": "readme_security_audit", "label": "Automated Security Audit", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The audit checks hard-coded links and state-file integrity."}, {"id": "readme_local_secret_storage", "label": "Local-Only API Key Storage", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "API keys remain on the user's machine and are excluded from logs to limit credential exposure."}, {"id": "readme_ai_provider_auto_detection", "label": "AI Provider Auto-Detection", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The provider type is inferred from the Base URL so one settings flow can support multiple compatible AI services."}, {"id": "readme_openai", "label": "OpenAI", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url