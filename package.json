{
  "name": "YJAutoPostOnX",
  "version": "5.19.0",
  "description": "Automated posting tool for X.com (Twitter) — AI tweet generation, CSV-based scheduling, Playwright automation",
  "main": "dev/main.js",
  "scripts": {
    "start": "electron .",
    "build:linux": "electron-builder --linux AppImage",
    "build-deploy": "electron-builder --linux AppImage",
    "audit": "node -e \"const {runAudit,printReport}=require('./dev/security/auditor');printReport(runAudit());\"",
    "postinstall": "electron-builder install-app-deps",
    "rebuild:electron": "electron-builder install-app-deps",
    "test": "cross-env ELECTRON_RUN_AS_NODE=1 electron test/run-all.js",
    "test:baseline": "cross-env ELECTRON_RUN_AS_NODE=1 XPOSTER_TEST_SCOPE=baseline electron test/run-all.js",
    "test:workflow": "cross-env ELECTRON_RUN_AS_NODE=1 XPOSTER_TEST_SCOPE=workflow electron test/run-all.js",
    "test:electron": "xvfb-run -a electron --no-sandbox test/smoke.test.js && xvfb-run -a electron --no-sandbox test/ipc-generation.test.js && xvfb-run -a electron --no-sandbox test/full-ui.test.js"
  },
  "keywords": [
    "electron",
    "automation",
    "x",
    "twitter",
    "ubuntu"
  ],
  "author": "Antigravity",
  "license": "ISC",
  "dependencies": {
    "better-sqlite3": "12.4.1",
    "csv-parser": "^3.0.0",
    "playwright": "^1.43.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  },
  "devDependencies": {
    "cross-env": "10.1.0",
    "electron": "30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.yj.autopostonx",
    "productName": "YJAutoPostOnX",
    "directories": {
      "output": "dist"
    },
    "files": [
      "dev/**/*",
      "package.json",
      "!test/**/*"
    ],
    "asarUnpack": [
      "**/*.node",
      "**/node_modules/better-sqlite3/**/*"
    ],
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    }
  },
  "allowScripts": {
    "electron@30.0.0": true
  }
}
