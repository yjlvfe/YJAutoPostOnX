# Ignore all .md docs except README, LICENSE, MASTER_TODO, and PROGRESS_HISTORY
*.md
!README.md
!LICENSE
!LICENSE.md
!MASTER_TODO.md
!PROGRESS_HISTORY.md
!RESOURCE_CLEANUP_REPORT.md

# Reports whitelisting for handoff and audit
!Bot/Reports/RepairHandoff/**/*.md
!Bot/Reports/**/*.md

__pycache__/
*.pyc

node_modules/
dist/
.env
.env.local
Bot/.env.local
.DS_Store
*.log
*.AppImage
.opencode/graphify-out/
graphify-out/
state.sqlite
Bot/state.sqlite
Bot/data/
Bot/.venv-direct-x/
